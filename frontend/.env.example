# Mocks are the default so `npm run dev` works with nothing else running.
# Set to false to talk to the real backend.
NEXT_PUBLIC_USE_MOCKS=false

# Local backend (python backend/local_server.py) — the default so a fresh
# clone runs without any deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Deployed backend: swap in the ApiEndpoint output from `sam deploy`.
# NEXT_PUBLIC_API_BASE_URL=https://<your-api-id>.execute-api.<region>.amazonaws.com/Prod
