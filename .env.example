# Copy to .env and fill in. Loaded automatically by backend/local_server.py.
# .env is gitignored — never commit real keys.

# Reasoning provider: bedrock | groq | anthropic | ollama | litellm
AAHAR_USE_AGENT=true
AAHAR_MODEL_PROVIDER=groq

# Groq (free tier: console.groq.com/keys)
GROQ_API_KEY=

# Bedrock, once the AWS account is available
# AAHAR_MODEL_PROVIDER=bedrock
# AAHAR_BEDROCK_MODEL=
# AWS_REGION=
