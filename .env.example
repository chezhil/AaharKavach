# Copy to .env and fill in. Loaded automatically by backend/local_server.py.
# .env is gitignored — never commit real keys.

# Reasoning provider: groq | anthropic | ollama | litellm
AAHAR_USE_AGENT=true
AAHAR_MODEL_PROVIDER=groq

# Groq (free tier: console.groq.com/keys). Without a key the deterministic
# rulebook answers instead, which is a safe default rather than an error.
GROQ_API_KEY=

# Optional: ask for a specific model. Blank uses the provider's own default.
# AAHAR_MODEL_ID=

# Label-photo OCR: textract (AWS) or tesseract (local, needs the binary).
AAHAR_OCR=textract
AWS_REGION=us-east-1
